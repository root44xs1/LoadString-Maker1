end)

-- Teleport handlers (teleport safely using CFrame)
tp1Btn.MouseButton1Click:Connect(function()
	if savedPositions[1] then
		local hrp = getHRP()
		if hrp then
			-- tentativa segura: set CFrame preserving orientation
			hrp.CFrame = savedPositions[1]
