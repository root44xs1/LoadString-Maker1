local selectedTarget = nil
local function rebuildPlayerList()
	for _, c in ipairs(dropFrame:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(1, 0, 0, 26)
			b.BackgroundTransparency = 1
			b.TextColor3 = Color3.fromRGB(0,0,0)
			b.Font = Enum.Font.Gotham
			b.TextSize = 14
			b.Text = p.Name
			b.Parent = dropFrame
			b.MouseButton1Click:Connect(function()
				playerDropdown.Text = p.Name
				selectedTarget = p
				dropFrame.Visible = false
			end)
		end
	end
end

Players.PlayerAdded:Connect(rebuildPlayerList)
Players.PlayerRemoving:Connect(function(r)
	-- se o target saiu, limpa e volta camera pro player
	if selectedTarget == r then
		selectedTarget = nil
		if player.Character and player.Character:FindFirstChildWhichIsA("Humanoid") then
			camera.CameraSubject = player.Character:FindFirstChildWhichIsA("Humanoid")
		end
	end
	rebuildPlayerList()
end)
rebuildPlayerList()

playerDropdown.MouseButton1Click:Connect(function()
	dropFrame.Visible = not dropFrame.Visible
end)

local spying = false
spyButton.MouseButton1Click:Connect(function()
	if spying then
		-- desativa spy: volta câmera
		if player.Character and player.Character:FindFirstChildWhichIsA("Humanoid") then
			camera.CameraSubject = player.Character:FindFirstChildWhichIsA("Humanoid")
		end
		spying = false
		spyButton.Text = "Spy"
	else
		if selectedTarget and selectedTarget.Character and selectedTarget.Character:FindFirstChildWhichIsA("Humanoid") then
			camera.CameraSubject = selectedTarget.Character:FindFirstChildWhichIsA("Humanoid")
			spying = true
			spyButton.Text = "Desativar"
		end
	end
end)

